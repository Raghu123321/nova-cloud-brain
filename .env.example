# ============================================================
# NOVA Cloud Brain Environment Configuration
# ============================================================

# Master Admin Account Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Secret API Key to authenticate requests (Generate a 32+ character random string)
# Clients (PC Assistant / Mobile App) must pass this in the 'X-API-Key' header
BRAIN_API_KEY=nb_live_change_this_to_a_secure_random_key_12345

# LLM Provider Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
# Optional: Can also configure Groq or OpenRouter if preferred
# GROQ_API_KEY=gsk_...

# Supabase PostgreSQL Connection String (Pooler or Direct URI)
# Find this in Supabase Project Settings -> Database -> Connection URI (Transaction pooler on port 6543 or Session pooler on 5432)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Vector Collection / Table Name in Supabase
COLLECTION_NAME=nova_memories

# Server Port (Render sets this dynamically via $PORT)
PORT=8000

